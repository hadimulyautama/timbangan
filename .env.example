# Contoh environment Pos Timbang.
#
# Salin jadi `.env` lalu isi yang perlu. Nilai di bawah adalah BAWAANNYA;
# baris berkomentar berarti "boleh dibiarkan".
#
# Sampai 11 September 2026 berkas ini tak ada sama sekali, jadi satu-satunya
# cara mengetahui setelan apa saja yang dibaca modul ini adalah membaca
# app/timbangan/config.py. Temuan QA X-21.

# ── WAJIB ──
# Basis data. SATU database dipakai bersama produksi & kantor; chain
# migrasinya yang terpisah (alembic_version_timbangan).
DATABASE_URL=postgresql+asyncpg://postgres:ganti@127.0.0.1:5432/hmu

# Kunci penanda-tangan cookie sesi. WAJIB diisi di server.
TIMBANGAN_SECRET_KEY=

# Sandi awal akun admin pertama. Diganti sesudah masuk pertama kali.
TIMBANGAN_ADMIN_PASSWORD=

# ── Seam Timbangan → Produksi (pemicu sinkron kontak Kledo) ──
# TIDAK berawalan TIMBANGAN_: namanya sama persis dengan sisi produksi
# (lihat produksi/.env.example) dan dengan pola yang sama di kantor
# (app/config.py di sana) — satu nama untuk satu seam di semua sisinya.
# Timbangan TIDAK PERNAH memegang KLEDO_API_KEY sendiri; lihat
# app/timbangan/klien_produksi.py.
PRODUKSI_API_URL=
PRODUKSI_API_TOKEN=
# PRODUKSI_API_TIMEOUT=120

# ── Opsional (nilai = bawaannya) ──
# TIMBANGAN_SESI_HARI=180
# TIMBANGAN_KAPASITAS_JEMBATAN_KG=20000.0
# TIMBANGAN_KELIPATAN_TERA_KG=10.0
# TIMBANGAN_KAPASITAS_TIMBANGAN_KECIL_KG=500.0
# TIMBANGAN_MAKS_FOTO_BYTE=4194304
# TIMBANGAN_JAM_KUNCI_OTOMATIS=24
# TIMBANGAN_JAM_TIKET_MENGANGGUR=12
# TIMBANGAN_JAM_MUNDUR_MAKSIMUM=48
# TIMBANGAN_PRINTER_URL=https://192.168.1.128
# TIMBANGAN_PRINTER_DEVID=local_printer
# TIMBANGAN_PERUSAHAAN_NAMA=PT Hadi Mulya Utama
# TIMBANGAN_PERUSAHAAN_ALAMAT=Masaran, Kab. Sragen
# TIMBANGAN_PERUSAHAAN_TELEPON=+62 851-7416-7950
# TIMBANGAN_ADMIN_USERNAME=admin
# TIMBANGAN_ADMIN_NAMA=Administrator
